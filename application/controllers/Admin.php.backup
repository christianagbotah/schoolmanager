	/*FOR EVERYTHING ABOUT BOARDING SYSTEM MANAGEMENT*/
	/*create, update and delete boarding house*/
	function manageBoardingHouse($param="", $param2="", $param3="") {

		if ($this->session->userdata('admin_login') != 1)
			redirect(site_url('login'));

		if($param == 'create') {
			$houseData['house_name'] = trim($this->input->post('house_name'));
			$houseData['house_user_fee'] = $this->input->post('house_user_fee');
			$houseData['house_capacity'] = $this->input->post('house_capacity');
