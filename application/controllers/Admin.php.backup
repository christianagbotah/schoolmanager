					/*add the admission fee item and amount here*/
					$item_row2 = $this->financial_report_model->getBillItemDetailRow($this->input->post('item_id'));
					$bill_data['title'] = strtoupper(strtolower($item_row2->title));
					$bill_data['description'] = $item_row2->description;
					$bill_data['amount'] = $this->input->post('my_admission_fee');
					$bill_data['amount_paid'] = 0;
					$bill_data['due'] = $bill_data['amount'];
