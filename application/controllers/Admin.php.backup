								'approved_by' => $approved_by,
								'approved_at' => $approved_at,
								'notes' => 'Invoice discount assigned during admission'
							));
							
							$applicable_total = 0;
							$applicable_items = array();
							
							if($profile->bill_item_ids === '*') {
								// Wildcard: check all bills against history
								foreach($bills_array as $idx => $bill) {
									$this->db->where('bill_item_id', $bill['bill_item_id'])
											->where('class_id', $data2['class_id'])
											->where('year', $running_year)
											->where('term', $running_term)
											->where_in('residence_type', array($data2['residence_type'], 'Both'));
									$history = $this->db->get('bill_item_history')->row();
									
									if($history) {
										$applicable_total += $batchDataInsert[$idx]['amount'];
										$applicable_items[] = $idx;
									}
								}
							} else {
								// Specific items: check each against history
								$profile_bill_items = explode(',', $profile->bill_item_ids);
								foreach($bills_array as $idx => $bill) {
									if(in_array($bill['bill_item_id'], $profile_bill_items)) {
										$this->db->where('bill_item_id', $bill['bill_item_id'])
												->where('class_id', $data2['class_id'])
												->where('year', $running_year)
												->where('term', $running_term)
												->where_in('residence_type', array($data2['residence_type'], 'Both'));
										$history = $this->db->get('bill_item_history')->row();
										
										if($history) {
											$applicable_total += $batchDataInsert[$idx]['amount'];
											$applicable_items[] = $idx;
										}
									}
								}
							}
							
							$discount_amount = $profile->discount_method == 'percentage' 
								? ($applicable_total * $profile->discount_value) / 100 
