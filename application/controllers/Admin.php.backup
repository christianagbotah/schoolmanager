		$exams_array = $exams->result_array();

		if ($exams->num_rows() < 1) {
			echo ' <option value="">' . get_phrase('no_record_found!') . '</option>';
		} else {
			foreach ($exams_array as $row) {
				echo ' <option value="' . $row["exam_id"] . '">' . $row["name"] . '</option>';
			}
		}
	}

