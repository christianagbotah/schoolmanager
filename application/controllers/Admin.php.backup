			$this->db->insert('boarding_house', $houseData);
			$house_id = $this->db->insert_id();

			if($_FILES['house_image_link']['name']) {
				$config['upload_path'] = './uploads/boarding/';
				$config['allowed_types'] = 'jpg|jpeg|png';
				$config['file_name'] = 'house_'.$house_id;
				$config['max_size'] = 2048;
				$this->load->library('upload', $config);
				$this->upload->do_upload('house_image_link');
			}

			$this->session->set_flashdata('flash_message', 'Boarding house added successfully');
			redirect(site_url('admin/manageBoardingHouse'));
			return;
		}

		if($param == 'update') {
			$houseData['house_name'] = trim($this->input->post('house_name'));
			$houseData['house_user_fee'] = $this->input->post('house_user_fee');
			$houseData['house_capacity'] = $this->input->post('house_capacity');
			$houseData['house_year_established'] = $this->input->post('house_year_established');
			$houseData['house_gps_code'] = $this->input->post('house_gps_code');
			$houseData['house_master_id'] = $this->input->post('house_master_id');
			$houseData['house_prefect_id'] = $this->input->post('house_prefect_id');
			$houseData['house_description'] = $this->input->post('house_description');

			$this->db->where('house_id', $param2);
			$this->db->update('boarding_house', $houseData);

			if($_FILES['house_image_link']['name']) {
				$config['upload_path'] = './uploads/boarding/';
				$config['allowed_types'] = 'jpg|jpeg|png';
				$config['file_name'] = 'house_'.$param2;
				$config['max_size'] = 2048;
				$this->load->library('upload', $config);
				$this->upload->do_upload('house_image_link');
			}

			if($param == 'update') {
				$house_id = $param2;
				
				$houseData = array();
				$houseData['house_name'] = $this->input->post('house_name');
				$houseData['house_user_fee'] = $this->input->post('house_user_fee');
				$houseData['house_capacity'] = $this->input->post('house_capacity');
				$houseData['house_year_established'] = $this->input->post('house_year_established');
				$houseData['house_gps_code'] = $this->input->post('house_gps_code');
				$houseData['house_master_id'] = $this->input->post('house_master_id');
				$houseData['house_prefect_id'] = $this->input->post('house_prefect_id');
				$houseData['house_description'] = $this->input->post('house_description');
				
				$this->db->where('house_id', $house_id);
				$result = $this->db->update('boarding_house', $houseData);
				
				if($result) {
					$this->session->set_flashdata('flash_message', 'BOARDING HOUSE UPDATED SUCCESSFULLY');
					redirect(site_url('admin/manageBoardingHouse?success=1'));
				} else {
					$this->session->set_flashdata('error_message', 'BOARDING HOUSE UPDATE FAILED');
					redirect(site_url('admin/manageBoardingHouse?success=0'));
				}
			}


			$this->session->set_flashdata('flash_message', 'Boarding house updated successfully');
			redirect(site_url('admin/manageBoardingHouse'));
			return;
		}

		if($param == 'delete') {
			$this->db->where('house_id', $param2);
			$this->db->delete('boarding_house');
			$this->session->set_flashdata('flash_message', 'Boarding house deleted successfully');
