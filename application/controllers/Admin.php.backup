        }
    }

	/*assign student to bed*/
	function assignStudentToBed($param='') {
		if($param == 'assign') {
			$data['student_id'] = $this->input->post('student_id');
			$data['bed_id'] = $this->input->post('bed_id');
			$data['assignment_date'] = date('Y-m-d');
			$data['status'] = 'active';
			$this->db->insert('bed_assignment', $data);
			$this->db->where('bed_id', $data['bed_id']);
			$this->db->update('boarding_bed', ['bed_status' => 'occupied']);
			echo json_encode(['status' => 'success']);
			return;
		}
	}

	/*release bed*/
	function releaseBed($bed_id='') {
		$this->db->where('bed_id', $bed_id);
		$this->db->where('status', 'active');
		$this->db->update('bed_assignment', ['status' => 'inactive', 'release_date' => date('Y-m-d')]);
		$this->db->where('bed_id', $bed_id);
		$this->db->update('boarding_bed', ['bed_status' => 'available']);
		echo json_encode(['status' => 'success']);
	}

