class Admin extends CI_Controller {
	function __construct() {
		parent::__construct();
		$this->load->database();
		$this->load->library('session');
		$this->load->model('discount_model');
		$this->load->model('Barcode_model');
		$this->load->model('Setting_model');
		$this->load->model('Boarding_model', 'boarding_model');
		$this->load->model('Financial_report_model', 'financial_report_model');
		$this->load->helper('discount_tracking');

		$this->load->model(array('Ajaxdataload_model' => 'ajaxload'));

		/*cache control*/
		$this->output->set_header('Cache-Control: no-store, no-cache, must-revalidate, post-check=0, pre-check=0');
		$this->output->set_header('Pragma: no-cache');

		//email control
		$this->load->helper('email');
		// $this->load->config('email');
		$this->load->library('email');

		//load form validation library and helper
		$this->load->helper('form');
		$this->load->library('form_validation');

		//load encryption library
		$this->load->library('encryption');

		//load invoice lock helper
		$this->load->helper('invoice_lock');

		if($this->session->userdata('login_type') == '') {
	        redirect(site_url('login'), 'refresh');
	    }
    }

