	function assign_boarding($param='') {
		if($this->session->userdata('admin_login') != 1)
			redirect(site_url('login'));
		if($param == 'single') {
			$student_id = $this->input->post('student_id');
			$house_id = $this->input->post('house_id');
			$dormitory_id = $this->input->post('dormitory_id');
			$bed_id = $this->input->post('bed_id');
			$running_year = $this->db->get_where('settings', array('type' => 'running_year'))->row()->description;
			$running_term = $this->db->get_where('settings', array('type' => 'running_term'))->row()->description;
			$this->db->where('student_id', $student_id);
			$this->db->where('year', $running_year);
			$this->db->where('term', $running_term);
			$this->db->update('enroll', array('house_id' => $house_id, 'dormitory_id' => $dormitory_id, 'bed_id' => $bed_id, 'residence_type' => 'Boarding'));
			$this->db->where('bed_id', $bed_id);
			$this->db->update('bed', array('bed_status' => 'occupied', 'student_id' => $student_id));
			$this->session->set_flashdata('flash_message', get_phrase('boarding_assigned_successfully'));
			redirect(site_url('admin/assign_boarding'));
		} elseif($param == 'bulk') {
			$student_ids = $this->input->post('student_ids');
			$house_id = $this->input->post('house_id');
			$dormitory_id = $this->input->post('dormitory_id');
			$running_year = $this->db->get_where('settings', array('type' => 'running_year'))->row()->description;
			$running_term = $this->db->get_where('settings', array('type' => 'running_term'))->row()->description;
			$available_beds = $this->db->get_where('bed', array('dormitory_id' => $dormitory_id, 'bed_status' => 'available'))->result_array();
			foreach($student_ids as $index => $student_id) {
				if(isset($available_beds[$index])) {
					$bed_id = $available_beds[$index]['bed_id'];
					$this->db->where('student_id', $student_id);
					$this->db->where('year', $running_year);
					$this->db->where('term', $running_term);
					$this->db->update('enroll', array('house_id' => $house_id, 'dormitory_id' => $dormitory_id, 'bed_id' => $bed_id, 'residence_type' => 'Boarding'));
					$this->db->where('bed_id', $bed_id);
					$this->db->update('bed', array('bed_status' => 'occupied', 'student_id' => $student_id));
				}
			}
			$this->session->set_flashdata('flash_message', get_phrase('bulk_boarding_assigned_successfully'));
			redirect(site_url('admin/assign_boarding'));
		}
		$page_data['page_name'] = '/boarding/student_assignment';
		$page_data['page_title'] = get_phrase('assign_boarding');
		$this->load->view('backend/main', $page_data);
	}

