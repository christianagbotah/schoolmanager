                            $student_id2 = $conduct['student_id'];
                            $class_id2 = $conduct['class_id'];
                            $term2 = $conduct['term'];
                            $year2 = $conduct['year'];
                            
                            // Collect selected conduct IDs from c1-c15 columns
                            for($i = 1; $i <= 15; $i++){
                                if(!empty($conduct['c'.$i])) {
                                    // Check if it's numeric ID (new system) or text (legacy)
                                    if(is_numeric($conduct['c'.$i])) {
                                        $selected_conduct_ids[] = $conduct['c'.$i];
                                    } else {
                                        // Legacy text - try to match by name
                                        foreach($conduct_items_from_db as $item) {
                                            if($item->name == $conduct['c'.$i]) {
                                                $selected_conduct_ids[] = $item->id;
                                                break;
                                            }
                                        }
                                    }
                                }
                            }   
                           
                        }

