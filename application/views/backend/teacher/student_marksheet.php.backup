                                                <?php
                                                    $item_count++;
                                                endforeach;
                                                
                                                // Close last row if needed
                                                if($item_count % $items_per_row != 0) {
                                                    // Fill remaining cells
                                                    $remaining = $items_per_row - ($item_count % $items_per_row);
